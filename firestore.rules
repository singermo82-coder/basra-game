rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Platform progression, wallet and social graph are server-owned.
    match /players/{uid} { allow read, write: if false; }
    match /friendCodes/{code} { allow read, write: if false; }
    match /friendRequests/{requestId} { allow read, write: if false; }
    match /events/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
